{
  "mcpServers": {
    "wallaby": {
      "command": "powershell.exe",
      "args": [
        "node",
        "$Env:USERPROFILE/.wallaby/mcp/"
      ],
      "alwaysAllow": [
        "wallaby_failingTests"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "alwaysAllow": [
        "browser_install"
      ],
      "disabled": false
    },
    "nx-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "nx-mcp@latest"
      ],
      "alwaysAllow": [
        "nx_workspace",
        "nx_current_running_tasks_details"
      ]
    }
  }
}